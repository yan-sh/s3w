cabal-version:      3.4
name:               s3w
version:            0.0.1
synopsis:           Simple S3-wrapper
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Yan Shkurinsky
maintainer:         yan.shkurinsky@gmail.com
-- copyright:
category:           Network
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall -Werror -O2
    default-extensions:
        LambdaCase
      , ViewPatterns
      , OverloadedStrings
      , BlockArguments
      , PartialTypeSignatures

executable s3w
    import:           warnings
    main-is:          Main.hs
    other-modules:
      Paths_s3w
    -- other-extensions:
    build-depends:
        base
      , warp
      , wai
      , minio-hs
      , http-types
      , conduit
      , http-conduit
      , text
      , http-client-tls
      , bytestring
      , binary
      , async
      , unliftio
      , co-log-json >= 0.1.0.2
      , aeson >= 2.0
      , time
    hs-source-dirs:   app
    default-language: GHC2021
    ghc-options: -threaded "-with-rtsopts= -N -A128m -AL256m -I0"
